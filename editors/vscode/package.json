{
  "name": "kcls",
  "displayName": "Kotlin (kcls)",
  "description": "Kotlin language support from kcls, the Kotlin language server built on the kc compiler",
  "version": "0.0.1",
  "publisher": "barteo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/barteo/kotlin-compiler-go",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "kotlin",
    "lsp",
    "kc"
  ],
  "activationEvents": [
    "onLanguage:kotlin",
    "workspaceContains:**/*.kt"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kotlin",
        "aliases": [
          "Kotlin",
          "kotlin"
        ],
        "extensions": [
          ".kt",
          ".kts"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kotlin",
        "scopeName": "source.kotlin",
        "path": "./syntaxes/kotlin.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[kotlin]": {
        "editor.defaultFormatter": "barteo.kcls"
      }
    },
    "configuration": {
      "title": "Kotlin (kcls)",
      "properties": {
        "kcls.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `kcls` binary. Empty: the binary bundled with the extension, else `kcls` on `PATH`. `kc` works too, with `-lsp` in `#kcls.args#`."
        },
        "kcls.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments for the language server."
        },
        "kcls.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the messages between VS Code and the language server in its output channel."
        },
        "kcls.hints.types": {
          "type": "boolean",
          "default": true,
          "description": "Show the inferred types of variables, properties and expression-bodied functions that don't declare them, unless the initializer makes them plain (a literal, a constructor call, a cast)."
        },
        "kcls.hints.parameterNames": {
          "type": "string",
          "enum": [
            "none",
            "literals",
            "all"
          ],
          "enumDescriptions": [
            "No parameter name hints.",
            "Name the parameters that literal arguments are passed to.",
            "Name the parameter of every positional argument."
          ],
          "default": "literals",
          "description": "Show the names of the parameters that positional arguments are passed to."
        },
        "kcls.hints.lambdas": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a lambda's implicit parameter `it` and its receiver `this`, with their types."
        }
      }
    },
    "commands": [
      {
        "command": "kcls.restartServer",
        "title": "Restart Language Server",
        "category": "Kotlin"
      },
      {
        "command": "kcls.showLog",
        "title": "Show Language Server Log",
        "category": "Kotlin"
      },
      {
        "command": "kcls.reimport",
        "title": "Reimport Project",
        "category": "Kotlin"
      },
      {
        "command": "kcls.clearCaches",
        "title": "Clear Caches and Reimport",
        "category": "Kotlin"
      },
      {
        "command": "kcls.run",
        "title": "Run",
        "category": "Kotlin"
      },
      {
        "command": "kcls.prepareRun",
        "title": "Prepare Run",
        "category": "Kotlin"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kcls.run",
          "when": "false"
        },
        {
          "command": "kcls.prepareRun",
          "when": "false"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "kcls",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The main class or tests a run code lens ran"
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package": "cp ../../LICENSE LICENSE && vsce package",
    "test": "npm run compile && node test/grammar.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
