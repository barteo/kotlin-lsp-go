{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kotlin",
  "scopeName": "source.kotlin",
  "fileTypes": ["kt", "kts"],
  "patterns": [
    { "include": "#code" }
  ],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#labels" },
        { "include": "#annotations" },
        { "include": "#strings" },
        { "include": "#characters" },
        { "include": "#numbers" },
        { "include": "#package-import" },
        { "include": "#declarations" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#calls" },
        { "include": "#operators" },
        { "include": "#braces" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.shebang.kotlin",
          "match": "\\A#!.*$"
        },
        {
          "name": "comment.block.documentation.kotlin",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "patterns": [
            { "name": "keyword.other.documentation.kdoc.kotlin", "match": "@[a-zA-Z]+\\b" },
            { "name": "markup.underline.link.kdoc.kotlin", "match": "\\[[^\\]]+\\]" }
          ]
        },
        {
          "name": "comment.block.kotlin",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#nested-block-comment" }]
        },
        {
          "name": "comment.line.double-slash.kotlin",
          "match": "//.*$"
        }
      ]
    },
    "nested-block-comment": {
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [{ "include": "#nested-block-comment" }]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.kotlin",
          "match": "(@)(?:(file|property|field|get|set|receiver|param|setparam|delegate|all)(:))?([A-Za-z_][\\w.]*)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.kotlin" },
            "2": { "name": "keyword.other.annotation-target.kotlin" },
            "3": { "name": "punctuation.separator.annotation.kotlin" },
            "4": { "name": "storage.type.annotation.kotlin" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.kotlin",
          "begin": "\\$*\"\"\"",
          "end": "\"\"\"(?!\")",
          "patterns": [{ "include": "#string-templates" }]
        },
        {
          "name": "string.quoted.double.kotlin",
          "begin": "\\$*\"",
          "end": "\"|$",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#string-templates" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        { "name": "constant.character.escape.kotlin", "match": "\\\\(?:[tbnr'\"\\\\$]|u[0-9A-Fa-f]{4})" },
        { "name": "invalid.illegal.escape.kotlin", "match": "\\\\." }
      ]
    },
    "string-templates": {
      "patterns": [
        {
          "name": "meta.template.expression.kotlin",
          "begin": "\\$+\\{",
          "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.kotlin" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.kotlin" } },
          "contentName": "source.kotlin.embedded",
          "patterns": [{ "include": "#code" }]
        },
        {
          "match": "(\\$+)([A-Za-z_][A-Za-z0-9_]*|`[^`]+`)",
          "captures": {
            "1": { "name": "punctuation.definition.template-expression.kotlin" },
            "2": { "name": "variable.other.template.kotlin" }
          }
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.kotlin",
      "match": "'(?:\\\\(?:[tbnr'\"\\\\$]|u[0-9A-Fa-f]{4})|[^'\\\\])'",
      "captures": {
        "0": { "patterns": [{ "include": "#string-escapes" }] }
      }
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.kotlin", "match": "\\b0[xX][0-9A-Fa-f_]+[uU]?[lL]?\\b" },
        { "name": "constant.numeric.binary.kotlin", "match": "\\b0[bB][01_]+[uU]?[lL]?\\b" },
        { "name": "constant.numeric.float.kotlin", "match": "(?:\\b[0-9][0-9_]*)?\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?[fF]?\\b|\\b[0-9][0-9_]*(?:[eE][+-]?[0-9_]+[fF]?|[fF])\\b" },
        { "name": "constant.numeric.integer.kotlin", "match": "\\b[0-9][0-9_]*[uU]?[lL]?\\b" }
      ]
    },
    "package-import": {
      "patterns": [
        {
          "match": "^\\s*(package)\\s+([\\w.`]+)",
          "captures": {
            "1": { "name": "keyword.other.package.kotlin" },
            "2": { "name": "entity.name.namespace.kotlin" }
          }
        },
        {
          "match": "^\\s*(import)\\s+([\\w.`]+(?:\\.\\*)?)(?:\\s+(as)\\s+([\\w`]+))?",
          "captures": {
            "1": { "name": "keyword.other.import.kotlin" },
            "2": { "name": "entity.name.namespace.kotlin" },
            "3": { "name": "keyword.other.as.kotlin" },
            "4": { "name": "entity.name.type.alias.kotlin" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(class|interface|typealias)\\s+([A-Za-z_][\\w]*|`[^`]+`)",
          "captures": {
            "1": { "name": "storage.type.class.kotlin" },
            "2": { "name": "entity.name.type.class.kotlin" }
          }
        },
        {
          "match": "\\b(object)\\s+([A-Za-z_][\\w]*|`[^`]+`)",
          "captures": {
            "1": { "name": "storage.type.object.kotlin" },
            "2": { "name": "entity.name.type.object.kotlin" }
          }
        },
        {
          "match": "\\b(fun)\\b(?:\\s*<[^>]*>)?\\s*(?:([\\w.<>?, ]+)\\.)?([A-Za-z_][\\w]*|`[^`]+`)?",
          "captures": {
            "1": { "name": "storage.type.function.kotlin" },
            "2": { "name": "entity.name.type.receiver.kotlin" },
            "3": { "name": "entity.name.function.kotlin" }
          }
        },
        {
          "match": "\\b(val|var)\\s+(?:([\\w.<>?]+)\\.)?([A-Za-z_][\\w]*|`[^`]+`)",
          "captures": {
            "1": { "name": "storage.type.variable.kotlin" },
            "2": { "name": "entity.name.type.receiver.kotlin" },
            "3": { "name": "variable.other.declaration.kotlin" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.kotlin", "match": "\\b(if|else|when|for|while|do|try|catch|finally|throw|return|break|continue)\\b" },
        { "name": "keyword.operator.type.kotlin", "match": "\\b(as\\??|is|!is|in|!in)\\b" },
        { "name": "storage.type.kotlin", "match": "\\b(class|interface|object|fun|val|var|typealias|constructor|init|companion|by|where|get|set|field)\\b" },
        { "name": "storage.modifier.kotlin", "match": "\\b(public|private|protected|internal|abstract|final|open|override|sealed|data|enum|annotation|inner|lateinit|const|inline|noinline|crossinline|reified|tailrec|operator|infix|external|suspend|vararg|out|expect|actual|value|context)\\b" },
        { "name": "variable.language.this.kotlin", "match": "\\b(this|super)\\b(@\\w+)?" }
      ]
    },
    "constants": {
      "name": "constant.language.kotlin",
      "match": "\\b(true|false|null)\\b"
    },
    "labels": {
      "patterns": [
        { "name": "entity.name.label.kotlin", "match": "\\b(?!(?:return|break|continue|this|super)@)[A-Za-z_]\\w*@(?=\\s*[{(\\w])" },
        { "name": "entity.name.label.kotlin", "match": "(?<=\\breturn|\\bbreak|\\bcontinue)@\\w+" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.builtin.kotlin", "match": "\\b(Any|Unit|Nothing|String|Char|Boolean|Byte|Short|Int|Long|Float|Double|UByte|UShort|UInt|ULong|Array|List|MutableList|Set|MutableSet|Map|MutableMap)\\b" },
        { "name": "entity.name.type.kotlin", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=(?:<[^<>]*>)?\\s*[({])",
      "captures": {
        "1": { "name": "entity.name.function.call.kotlin" }
      }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.kotlin", "match": "->|=>" },
        { "name": "keyword.operator.elvis.kotlin", "match": "\\?:" },
        { "name": "keyword.operator.safe-call.kotlin", "match": "\\?\\.|!!" },
        { "name": "keyword.operator.range.kotlin", "match": "\\.\\.<?" },
        { "name": "keyword.operator.reference.kotlin", "match": "::" },
        { "name": "keyword.operator.comparison.kotlin", "match": "===?|!==?|<=|>=" },
        { "name": "keyword.operator.assignment.kotlin", "match": "[-+*/%]?=" },
        { "name": "keyword.operator.logical.kotlin", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.kotlin", "match": "\\+\\+|--|[-+*/%]" }
      ]
    },
    "braces": {
      "patterns": [
        {
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.block.begin.kotlin" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.block.end.kotlin" } },
          "patterns": [{ "include": "#code" }]
        }
      ]
    }
  }
}
